# Needed only to run `npm run embed` and `npm run precompute` once.
# Leave it out of your Vercel project unless you enable live mode.
OPENAI_API_KEY=

# Live mode (off by default). Uses OPENAI_API_KEY on the server.
LIVE_MODE_ENABLED=false
# Requests allowed per IP per window, the window length, and a daily cap per server instance.
LIVE_RATE_LIMIT=5
LIVE_RATE_WINDOW_MINUTES=60
LIVE_DAILY_BUDGET=200

# Optional: shows a "Source" link in the header.
NEXT_PUBLIC_REPO_URL=
