# One key is enough. `npm run embed` uses Gemini if GEMINI_API_KEY is set,
# otherwise OpenAI. Force a choice with AI_PROVIDER=gemini or AI_PROVIDER=openai.
# The key is only needed for `npm run embed` and `npm run precompute`
# (and for live mode, if you enable it). Never commit .env.local.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=

# Optional: chat models to try, in order, comma-separated (e.g. gemini-3.8-flash,gemini-flash-lite-latest).
NEXT_PUBLIC_GEMINI_CHAT_MODEL=
NEXT_PUBLIC_OPENAI_CHAT_MODEL=

# Live mode (off by default). Uses the key of the provider the catalog was embedded with.
LIVE_MODE_ENABLED=false
# Requests allowed per IP per window, the window length, and a daily cap per server instance.
LIVE_RATE_LIMIT=5
LIVE_RATE_WINDOW_MINUTES=60
LIVE_DAILY_BUDGET=200

# Optional: shows a "Source" link in the header.
NEXT_PUBLIC_REPO_URL=
